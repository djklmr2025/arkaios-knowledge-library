# ARKAIOS Knowledge Library - Meta Graph API Configuration
# IMPORTANTE: Este archivo es estrictamente local y está protegido en .gitignore.
# NUNCA compartas tus secretos ni tokens en el chat.

# 1. Credenciales de tu App en developers.facebook.com (Configuración de la app -> Básica)
META_APP_ID=
META_APP_SECRET=

# 2. Token de Usuario generado en Graph API Explorer (con permisos pages_show_list, pages_read_engagement, pages_read_user_content)
META_USER_TOKEN=

# 3. Token y ID de Página (Se pueden generar automáticamente ejecutando 'node meta_token_manager.mjs')
FACEBOOK_PAGE_TOKEN=
FACEBOOK_PAGE_ID=
